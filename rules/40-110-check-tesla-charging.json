{
	"debug": true,
	"conditions": {
		"check-event-type-hour": "'${body.cron-event}' === 'Hour'",
		"check-event-time": " /T19|T20|T21|T22/.test( '${body.cron-event-time}' ) ",
		"check-tesla-near-veh-1-space": " ${Vehicles.Tesla_0.distance_to_home} < 0.005 ",
		"check-tesla-not-plugged-in": " ! /Complete|Charging/.test( '${Vehicles.Tesla_0.charge_state.charging_state}' ) ",
		"enabled": true
	},
	"conditions_normal": {
		"check-event-type-hour": "'${body.cron-event}' === 'Hour'",
		"check-event-time": " /T19|T20|T21|T22/.test( '${body.cron-event-time}' ) ",
		"check-tesla-near-veh-1-space": " ${Vehicles.Tesla_0.distance_to_home} < 0.005 ",
		"check-tesla-not-plugged-in": " ( '${Vehicles.Tesla_0.charge_state.charge_port_latch}' !== 'Engaged' ) && ( '${Vehicles.Tesla_0.charge_state.charging_state}' !== 'Complete' ) ",
		"enabled": true
	},
	"conditions_scratch": {
		"check-event-type-hour": "'${body.cron-event}' === 'Hour'",
		"check-event-type-minute": "'${body.cron-event}' === 'Minute'",
		"check-event-time": " /T19|T20|T21/.test( '${body.cron-event-time}' ) ",
		"check-tesla-not-plugged-in_": " ( '${Vehicles.Tesla_0.charge_state.charge_port_latch}' !== 'Engaged' ) && ( '${Vehicles.Tesla_0.charge_state.charging_state}' !== 'Complete' ) ",
		"check-tesla-not-plugged-in": " '${Vehicles.Tesla_0.charge_state.charge_port_latch}' !== 'Engaged' ",
		"enabled": true
	},
	"actions": {
		"action-tag": { 
			"type": "tag", 
			"value": "alert - tesla not plugged-in",
			"expire": 3600
		},
		"action-set-var": { 
			"type": "set", 
			"name": "ALERT--Tesla is not plugged in",
			"value": "TODO: add email action.."
		},
		"post-rule email action": {
			"type": "endpoint",
			"endpoint": "${url_base_post_rule_actions}",
			"method": "POST",
			"body": {
				"action": "email",
				"email_subject": "Tesla is not plugged in",
				"email_body": "Tesla is detected in VEH-1 but may not be connected to power.\n\nEvent ${event_id}\nVM Host ${vm_host}\n\n charging_state = ${Vehicles.Tesla_0.charge_state.charging_state}\n charge_port_latch = ${Vehicles.Tesla_0.charge_state.charge_port_latch}\n distance_to_home = ${Vehicles.Tesla_0.distance_to_home} km\n\n charge_rate = ${Vehicles.Tesla_0.charge_state.charge_rate}\n charger_actual_current = ${Vehicles.Tesla_0.charge_state.charger_actual_current}\n time_to_full_charge = ${Vehicles.Tesla_0.charge_state.time_to_full_charge} hours\n minutes_to_full_charge = ${Vehicles.Tesla_0.charge_state.minutes_to_full_charge} minutes\n\n battery_level = ${Vehicles.Tesla_0.charge_state.battery_level} %\n battery_range = ${Vehicles.Tesla_0.charge_state.battery_range}\n",
				"email_attachments": ""
			}
		}
	}
}
