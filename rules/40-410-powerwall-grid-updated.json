{
	"labels": [ "powerwall" ],
	"vars": {
		"is-weekend": " ${Calendar.day-of-week.is-weekend} ",
		"status-9nk": " '${Electric.powerwall-9NK.grid-status.value}' ",
		"status-bbw": " '${Electric.powerwall-BBW.grid-status.value}' ",
		"grid-status-old": " '${Electric.grid.value}' ",
		"grid-status-new": " ( '${Electric.powerwall-9NK.grid-status}' === 'SystemGridConnected' ) && ( '${Electric.powerwall-BBW.grid-status}' === 'SystemGridConnected' ) ? 'up' : 'down' ",
		"grid-status-01": " ( '${Electric.powerwall-9NK.grid-status.value}' === 'SystemGridConnected' ) && ( '${Electric.powerwall-BBW.grid-status.value}' === 'SystemGridConnected' ) ? 'up' : 'down' ",
		"grid-status-02": " ( ( '${Electric.powerwall-9NK.grid-status.value}' === 'SystemGridConnected' ) && ( '${Electric.powerwall-BBW.grid-status.value}' === 'SystemGridConnected' ) ) ? 'up' : 'down' ",
		"grid-status-03": " ( ( '${Electric.powerwall-9NK.grid-status.value}' === 'SystemGridConnected' ) && ( '${Electric.powerwall-BBW.grid-status.value}' === 'SystemGridConnected' ) ) ",
		"grid-status-04": " ( '${Electric.powerwall-9NK.grid-status.value}' === 'SystemGridConnected' && '${Electric.powerwall-BBW.grid-status.value}' === 'SystemGridConnected' ) ",
		"grid-status-05": " ( '${Electric.powerwall-9NK.grid-status.value}' === '${Electric.powerwall-BBW.grid-status.value}' === 'SystemGridConnected' ) ",
		"grid-status-06": " ( 'test' === 'test' === 'test' ) ? 'true-result' : 'false-result' ",
		"_": "0"
	},
	"conditions": {
		"check-event-type": " '${body.endpoint}' === 'grid-status' ",
		"changed-grid-status": " '${grid-status-new}' !== '${Electric.grid.value}  xxx' "
	},
	"_conditions": {
		"check-pw-instancee": " [ '9NK', 'BBW' ].includes( '${body.instance}' ) ",
		"check-event-type": " [ 'alerts-pw', 'grid-status', 'api-sitemaster' ].includes( '${body.endpoint}' ) "
	},
	"actions": {
		"action-set-var grid-status": { 
			"type": "set", 
			"name": "Electric",
			"path": "$.grid",
			"value": "${grid-status-new}"
		}
	}
}
