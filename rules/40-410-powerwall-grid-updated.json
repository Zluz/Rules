{
	"labels": [ "powerwall" ],
	"vars": {
		"is-weekday": " ! ${Calendar.day-of-week.is-weekend} ",
		"status-9nk": " '${Electric.powerwall-9NK.grid-status}' ",
		"status-bbw": " '${Electric.powerwall-BBW.grid-status}' ",
		"grid-status-old": " '${Electric.grid.value}' ",
		"grid-status-new": " ( '${Electric.powerwall-9NK.grid-status}' === 'SystemGridConnected' ) && ( '${Electric.powerwall-BBW.grid-status}' === 'SystemGridConnected' ) ? 'up' : 'down' ",
		"grid-status-01": " ( '${Electric.powerwall-9NK.grid-status.value}' === 'SystemGridConnected' ) && ( '${Electric.powerwall-BBW.grid-status.value}' === 'SystemGridConnected' ) ? 'up' : 'down' ",
		"_": "0"
	},
	"conditions": {
		"check-event-type": " '${body.endpoint}' === 'grid-status' ",
		"changed-grid-status": " '${grid-status-new}' !== '${Electric.grid}' "
	},
	"_conditions": {
		"check-pw-instancee": " [ '9NK', 'BBW' ].includes( '${body.instance}' ) ",
		"check-event-type": " [ 'alerts-pw', 'grid-status', 'api-sitemaster' ].includes( '${body.endpoint}' ) "
	},
	"actions": {
		"action-set-var grid-status": { 
			"type": "set", 
			"name": "Electric",
			"path": "$.grid",
			"value": "${grid-status-new}"
		}
	}
}
