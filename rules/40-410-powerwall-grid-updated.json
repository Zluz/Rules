{
	"labels": [ "powerwall" ],
	"vars": {
		"status-9nk": " '${Electric.powerwall-9NK.grid-status.value}' ",
		"status-bbw": " '${Electric.powerwall-BBW.grid-status.value}' ",
		"grid-status-new-bool": " ( ( '${status-9nk}' === 'SystemGridConnected' ) && ( '${status-bbw}' === 'SystemGridConnected' ) ) ",
		"grid-status-new-value": " ${grid-status-new-bool} ? 'up' : 'down' ",
		"grid-status-old-value": " '${Electric.grid.value}' ",
		"_": "0"
	},
	"conditions": {
		"check-event-type": " '${body.endpoint}' === 'grid-status' ",
		"changed-grid-status": " '${grid-status-new-value}' !== '${Electric.grid.value}' "
	},
	"_conditions": {
		"check-pw-instancee": " [ '9NK', 'BBW' ].includes( '${body.instance}' ) ",
		"check-event-type": " [ 'alerts-pw', 'grid-status', 'api-sitemaster' ].includes( '${body.endpoint}' ) "
	},
	"actions": {
		"action-set-var grid-status": { 
			"type": "set", 
			"name": "Electric",
			"path": "$.grid",
			"value": "${grid-status-new-value}",
			"add": {
				"system-changed": "${body.instance}",
				"system-previous-grid-status": "${body.previous.grid_status}"
			}
		}
	}
}
