{
	"debug": false,
	"labels": [ "powerwall-response" ],
	"vars": {
		"system": " '${headers.calling_action}'.substring(5,8) "
	},
	"conditions": {
		"enabled": "true"
	},
	"actions": {
		"set: Electric.powerwall-(system).pod": { 
			"type": "set", 
			"name": "Electric",
			"path": "$.powerwall-${system}.pod",
			"value": "${body.nominal_energy_remaining}",
			"add": {
				"nominal_energy_remaining": "${body.nominal_energy_remaining}",
				"nominal_full_pack_energy": "${body.nominal_full_pack_energy}",
				"time_remaining_hours": "${body.time_remaining_hours}",
				"backup_reserve_percent": "${body.backup_reserve_percent}",
				"PW1_POD_nom_energy_remaining": "${body.PW1_POD_nom_energy_remaining}",
				"PW1_POD_nom_full_pack_energy": "${body.PW1_POD_nom_full_pack_energy}",
				"PW1_pinv_state": "${body.PW1_pinv_state}",
				"PW1_pinv_grid_state": "${body.PW1_pinv_grid_state}",
				"PW1_OpSeqState": "${body.PW1_OpSeqState}",
				"PW2_POD_nom_energy_remaining": "${body.PW2_POD_nom_energy_remaining}",
				"PW2_POD_nom_full_pack_energy": "${body.PW2_POD_nom_full_pack_energy}",
				"PW2_pinv_state": "${body.PW2_pinv_state}",
				"PW2_pinv_grid_state": "${body.PW2_pinv_grid_state}",
				"PW2_OpSeqState": "${body.PW2_OpSeqState}"
			}
		},
		"set: Electric.powerwall-(system).pod.pw1": { 
			"type": "set", 
			"name": "Electric",
			"path": "$.powerwall-${system}.pod.pw1",
			"value": "${body.nominal_energy_remaining}",
			"add": {
				"POD_nom_energy_remaining": "${body.PW1_POD_nom_energy_remaining}",
				"POD_nom_full_pack_energy": "${body.PW1_POD_nom_full_pack_energy}",
				"pinv_state": "${body.PW1_pinv_state}",
				"pinv_grid_state": "${body.PW1_pinv_grid_state}",
				"OpSeqState": "${body.PW1_OpSeqState}"
			}
		},
		"set: Electric.powerwall-(system).pod.pw2": { 
			"type": "set", 
			"name": "Electric",
			"path": "$.powerwall-${system}.pod.pw2",
			"value": "${body.nominal_energy_remaining}",
			"add": {
				"POD_nom_energy_remaining": "${body.PW2_POD_nom_energy_remaining}",
				"POD_nom_full_pack_energy": "${body.PW2_POD_nom_full_pack_energy}",
				"pinv_state": "${body.PW2_pinv_state}",
				"pinv_grid_state": "${body.PW2_pinv_grid_state}",
				"OpSeqState": "${body.PW2_OpSeqState}"
			}
		}
	}
}
